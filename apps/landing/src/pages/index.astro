---
import '@fontsource/sora/latin-800.css';
import '@fontsource/plus-jakarta-sans/latin-500.css';
import '@fontsource/plus-jakarta-sans/latin-700.css';
import '@fontsource/plus-jakarta-sans/latin-800.css';
import '@ufba-app/tokens/tokens.css';
import '../styles/landing.css';
import Check from '../components/Check.astro';
import Seta from '../components/Seta.astro';
import { DOCS_URL, PANEL_URL } from '../lib';
import textos from '../content/textos.json';

const title = 'ufba.app: seu semestre num lugar só';
const description = 'Uma conta que reúne SIGAA, Moodle e Classroom, para você e para a sua IA.';

const { perguntasCima, perguntasBaixo, confianca, seguranca, duvidas, etapas } = textos;

---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1b2a7a" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href="https://ufba.app/" />
    <link rel="icon" type="image/svg+xml" href="/img/brasao.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://ufba.app/" />
  </head>
  <body>
    <header class="lp-barra" id="topo">
      <div class="lp-in">
        <a class="lp-logo" href="#topo" aria-label="ufba.app"><img src="/img/brasao.svg" width="40" height="40" alt="" />ufba.app</a>
        <nav class="lp-nav" aria-label="Seções da página">
          <a href="#ifs">Como usar</a>
          <a href="#ia">Segurança</a>
          <a href="#duvidas">Dúvidas</a>
        </nav>
        <div class="lp-barra__dir">
          <a class="lp-lnk" href={DOCS_URL}>Documentação</a>
          <a class="bt lp-bt-entrar" href={PANEL_URL}>Entrar</a>
        </div>
      </div>
    </header>

    <main>
      <div class="lp-topo">
        <span class="forma forma-anel" aria-hidden="true"></span>

        <section class="lp-hero" aria-label="Apresentação">
          <div class="lp-in">
            <div class="lp-enter">
              <h1 aria-label="Seu semestre num lugar só."><span class="lp-tipo" aria-hidden="true"><span id="lp-typed">Seu semestre</span><i class="lp-cursor"></i></span><span class="lp-resto" aria-hidden="true">num lugar só.</span></h1>
              <p class="lp-hero__sub">Uma conta que reúne SIGAA, Moodle e Classroom, para você e para a sua IA.</p>
              <div class="lp-hero__cta">
                <a class="bt bt-pri" href={PANEL_URL}>Abrir o painel <Seta /></a>
                <small>Use a sua conta @ufba.br.</small>
              </div>
            </div>

            <div class="lp-orb-caixa lp-enter d2" aria-hidden="true">
              <div class="lp-orb">
                <span class="lp-orb__sol"></span>
                <span class="lp-orb__anel"></span>
                <svg class="lp-orb__linhas" viewBox="0 0 440 440" aria-hidden="true">
                  <g class="base"><path d="M220 38 L220 220" /><path d="M402 220 L220 220" /><path d="M220 402 L220 220" /><path d="M38 220 L220 220" /></g>
                  <g class="pulso"><path d="M220 38 L220 220" /><path class="p2" d="M402 220 L220 220" /><path class="p3" d="M220 402 L220 220" /><path class="p4" d="M38 220 L220 220" /></g>
                </svg>
                <span class="lp-orb__no lp-orb__no--1"><span class="lp-orb__ic"><img src="/img/brasao.svg" width="42" height="42" alt="" /></span></span>
                <span class="lp-orb__no lp-orb__no--2"><span class="lp-orb__ic"><img src="/img/moodle.svg" width="42" height="42" alt="" /></span></span>
                <span class="lp-orb__no lp-orb__no--3"><span class="lp-orb__ic"><img src="/img/classroom.svg" width="42" height="42" alt="" /></span></span>
                <span class="lp-orb__no lp-orb__no--4"><span class="lp-orb__ic"><img src="/img/siasb.png" width="42" height="42" alt="" /></span></span>
                <span class="lp-orb__centro">ufba.app</span>
              </div>
            </div>
          </div>
        </section>
      </div>

    <section class="lp-confia" aria-label="Por que confiar">
      <div class="lp-in">
        <ul>
          {confianca.map(({ titulo, detalhe }) => (
            <li><Check /><span><b>{titulo}</b><small>{detalhe}</small></span></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="lp-sec" aria-labelledby="ifs">
      <div class="lp-in">
        <h2 id="ifs">Uma conta, três portas.</h2>
        <p class="lp-sec__sub">Escolha por onde entrar. Os dados são os mesmos.</p>
        <div class="lp-portas">
          <a class="lp-porta lp-porta--painel" href={DOCS_URL} aria-label="Painel, em breve: ver na documentação">
            <span class="lp-porta__n">01</span>
            <h3>Painel <span class="lp-chip">Em breve</span></h3>
            <p>O semestre inteiro numa página do navegador.</p>
            <div class="lp-porta__chips"><span class="lp-chip">Horário</span><span class="lp-chip">Prazos</span><span class="lp-chip">Notas e faltas</span></div>
            <svg class="lp-porta__vis" viewBox="0 0 320 150" role="img" aria-label="Desenho de um painel com blocos e um sol">
              <rect x="8" y="8" width="304" height="134" rx="18" fill="#ffffff" stroke="#d3d9ec" stroke-width="2" />
              <circle class="pn-sol" cx="272" cy="42" r="22" fill="#ffc93c" />
              <rect class="pn-t" x="30" y="30" width="110" height="14" rx="7" fill="#1b2a7a" />
              <rect class="pn-s" x="30" y="56" width="170" height="10" rx="5" fill="#b9c2e6" />
              <rect class="pn-b pn-b1" x="30" y="76" width="64" height="48" rx="12" fill="#eef1fb" />
              <rect class="pn-b pn-b2" x="104" y="76" width="64" height="48" rx="12" fill="#1b2a7a" />
              <rect class="pn-b pn-b3" x="178" y="76" width="64" height="48" rx="12" fill="#eef1fb" />
              <rect class="pn-b pn-b4" x="252" y="76" width="42" height="48" rx="12" fill="#eef1fb" />
            </svg>
            <span class="lp-porta__ln">Ver na documentação <Seta /></span>
          </a>

          <a class="lp-porta lp-porta--ia" href={DOCS_URL} aria-label="Assistentes: ver na documentação">
            <span class="lp-porta__n">02</span>
            <h3>Assistentes</h3>
            <p>A sua IA acompanha o semestre, se você deixar.</p>
            <svg class="lp-porta__vis" viewBox="0 0 320 150" role="img" aria-label="Desenho de duas peças encaixadas: ufba.app e a sua IA">
              <g class="ia-a">
                <rect x="14" y="40" width="112" height="70" rx="20" fill="#ffffff" />
                <text x="70" y="82" text-anchor="middle" font-family="Sora, sans-serif" font-weight="800" font-size="15" fill="#1b2a7a">ufba.app</text>
              </g>
              <g class="ia-b">
                <rect class="ia-b__r" x="194" y="40" width="112" height="70" rx="20" fill="none" stroke="#ffffff" stroke-width="2.5" />
                <text x="250" y="82" text-anchor="middle" font-family="Sora, sans-serif" font-weight="800" font-size="15" fill="#ffffff">sua IA</text>
              </g>
              <path class="ia-fio" d="M126 75 L194 75" stroke="#ffffff" stroke-opacity=".5" stroke-width="2" stroke-dasharray="4 5" />
              <path class="lp-bolinha" d="M130 75 L144 75" stroke="#ffc93c" stroke-width="4" stroke-linecap="round" />
            </svg>
            <span class="lp-porta__ln">Ver na documentação <Seta /></span>
          </a>

          <a class="lp-porta lp-porta--grupo" href={DOCS_URL} aria-label="Grupos, em breve: saiba como vai funcionar">
            <span class="lp-porta__n">03</span>
            <h3>Grupos <span class="lp-chip">Em breve</span></h3>
            <p>A memória dos trabalhos em grupo, compartilhada entre quem faz parte.</p>
            <svg class="lp-porta__vis" viewBox="0 0 320 150" role="img" aria-label="Desenho de três círculos sobrepostos sobre uma nota compartilhada">
              <g class="gr-nota">
                <rect x="60" y="86" width="200" height="50" rx="16" fill="#ffffff" stroke="#d3d9ec" stroke-width="2" />
                <rect class="gr-l1" x="80" y="102" width="110" height="8" rx="4" fill="#b9c2e6" />
                <rect class="gr-l2" x="80" y="118" width="70" height="8" rx="4" fill="#d3d9ec" />
              </g>
              <circle class="gr-c1" cx="120" cy="52" r="30" fill="#1b2a7a" />
              <circle class="gr-c2" cx="160" cy="52" r="30" fill="#ffc93c" />
              <circle class="gr-c3" cx="200" cy="52" r="30" fill="#ffffff" stroke="#1b2a7a" stroke-width="3" />
            </svg>
            <span class="lp-porta__ln">Saiba como vai funcionar <Seta /></span>
          </a>
        </div>
      </div>
    </section>

    <section class="lp-sec lp-faixas-sec" aria-labelledby="le">
      <div class="lp-in">
        <h2 id="le">Perguntas que a sua IA responde.</h2>
        <p class="lp-sec__sub">Prazos, matérias, avisos, fóruns e arquivos, direto das três fontes.</p>
      </div>
      <div class="lp-faixas">
        <div class="lp-faixa">
          <div>{perguntasCima.map((p) => <span class="lp-p">{p}</span>)}</div>
          <div aria-hidden="true">{perguntasCima.map((p) => <span class="lp-p">{p}</span>)}</div>
        </div>
        <div class="lp-faixa lp-faixa--volta">
          <div>{perguntasBaixo.map((p) => <span class="lp-p lp-p--escura">{p}</span>)}</div>
          <div aria-hidden="true">{perguntasBaixo.map((p) => <span class="lp-p lp-p--escura">{p}</span>)}</div>
        </div>
      </div>
    </section>

    <section class="lp-sec lp-claro lp-saude" aria-labelledby="saude">
      <div class="lp-in">
        <div class="lp-saude__txt">
          <span class="lp-saude__tag"><img src="/img/siasb.png" width="40" height="40" alt="" />SIASB</span>
          <h2 id="saude">Para quem é da saúde.</h2>
          <p class="lp-sec__sub">Sua agenda de clínica e o prazo para marcar sessão, sem esquecer.</p>
        </div>
        <div class="lp-saude__vis" aria-hidden="true">
          <span class="lp-p lp-p--escura lp-saude__q">Falta marcar alguma clínica?</span>
          <b class="lp-saude__resp">Periodontia tem paciente, mas nenhuma sessão. Marque a de sexta até quarta, às 10h.</b>
          <div class="lp-saude__estados">
            <span class="selo selo-atendimento"><i></i>Atendimentos</span>
            <span class="lp-saude__passo"><span class="lp-saude__seta"></span><span class="selo selo-sessao"><i></i>Sessões</span></span>
            <span class="lp-saude__passo"><span class="lp-saude__seta"></span><span class="selo selo-procedimento"><i></i>Procedimentos</span></span>
          </div>
        </div>
      </div>
    </section>

    <section class="lp-sec lp-ia" aria-labelledby="ia">
      <span class="forma forma-sol" aria-hidden="true"></span>
      <div class="lp-in">
        <div>
          <h2 id="ia">Você decide o que a sua IA pode fazer.</h2>
          <p class="lp-sec__sub">Cada app pede a sua autorização e você revoga quando quiser.</p>
          <ul class="lp-ia__lista">
            {seguranca.map((texto) => <li><Check />{texto}</li>)}
          </ul>
        </div>

        <div class="lp-fluxo" role="img" aria-label="Exemplo do pedido de autorização de um app e, depois, a revogação do acesso">
          <div class="lp-fluxo__rotulo"><span class="lp-fluxo__n">1</span>Você autoriza</div>
          <div class="lp-fluxo__cartao">
            <div class="lp-fluxo__app">
              <span class="cliente__av" aria-hidden="true">C</span>
              <div><b>Claude</b> quer acessar os seus dados acadêmicos.</div>
            </div>
            <div class="lp-fluxo__dom"><span>Volta para</span><b>claude.ai</b><span class="lp-chip lp-chip--ok">Verificado</span></div>
            <div class="lp-fluxo__le">
              <small>Acessa</small>
              <span class="lp-fonte-chip"><span class="lp-fonte"><img src="/img/moodle.svg" width="18" height="18" alt="" /></span>Moodle</span>
              <span class="lp-fonte-chip"><span class="lp-fonte"><img src="/img/classroom.svg" width="18" height="18" alt="" /></span>Classroom</span>
              <span class="lp-fonte-chip"><span class="lp-fonte"><img src="/img/brasao.svg" width="18" height="18" alt="" /></span>SIGAA</span>
              <span class="lp-fonte-chip"><span class="lp-fonte"><img src="/img/siasb.png" width="18" height="18" alt="" /></span>SIASB</span>
            </div>
            <div class="lp-fluxo__bts">
              <span class="bt lp-bt-perigo">Recusar</span>
              <span class="bt bt-pri">Autorizar</span>
            </div>
          </div>

          <div class="lp-fluxo__fio" aria-hidden="true"></div>

          <div class="lp-fluxo__rotulo"><span class="lp-fluxo__n">2</span>Quando quiser, você revoga</div>
          <div class="lp-fluxo__cartao lp-fluxo__cartao--linha">
            <span class="cliente__av" aria-hidden="true">C</span>
            <div class="lp-fluxo__quem"><b>Claude</b><small>Autorizado em 4 nov · usado há 2 h</small></div>
            <span class="bt bt-recusar bt-sm"><svg class="ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="m6 6 1 14h10l1-14" /></svg>Revogar</span>
          </div>
        </div>
      </div>
    </section>

    <section class="lp-sec lp-claro lp-duvidas" aria-labelledby="duvidas">
      <div class="lp-in">
        <div class="lp-duvidas__lado">
          <h2 id="duvidas">Dúvidas comuns.</h2>
          <p class="lp-sec__sub">Não achou a sua? A resposta deve estar na documentação.</p>
          <a class="bt bt-borda" href={DOCS_URL}>Abrir a documentação</a>
        </div>
        <div class="lp-duvidas__lista">
          {duvidas.map(({ pergunta, resposta }, i) => (
            <details class="lp-q" name="duvidas" open={i === 0}><summary><span>{pergunta}</span><i class="lp-q__m" aria-hidden="true"></i></summary><p>{resposta}</p></details>
          ))}
        </div>
      </div>
    </section>

    <section class="lp-sec" aria-labelledby="como">
      <div class="lp-in">
        <h2 id="como">Da conta @ufba.br à primeira pergunta.</h2>
        <ol class="lp-etapas">
          {etapas.map(({ titulo, texto }, i) => (
            <li><span class="lp-etapas__n">{i + 1}</span><h3>{titulo}</h3><p>{texto}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="lp-final" aria-labelledby="fim">
      <span class="forma forma-sol" aria-hidden="true"></span>
      <span class="forma forma-anel" aria-hidden="true"></span>
      <div class="lp-in">
        <h2 id="fim">Entre com a sua conta @ufba.br.</h2>
        <a class="bt bt-pri" href={PANEL_URL}>Abrir o painel <Seta /></a>
      </div>
    </section>
    </main>

    <div class="lp-fixo">
      <a class="bt bt-pri" href={PANEL_URL}>Abrir o painel <Seta /></a>
      <small>Use a sua conta @ufba.br.</small>
    </div>

    <footer class="lp-rodape">
      <div class="lp-in">
        <span class="lp-logo"><img src="/img/brasao.svg" width="32" height="32" alt="" />ufba.app</span>
        <span>Projeto de estudante, código aberto. Não é serviço oficial da UFBA nem do SIGAA.</span>
        <a class="lp-rodape__lnk" href="/privacidade">Privacidade</a>
      </div>
    </footer>

    <script is:inline src="/typing.js" defer></script>
  </body>
</html>
