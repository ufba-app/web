# URL da API (o web e a API precisam estar no mesmo site; em dev, localhost).
VITE_API_URL=http://localhost:3000

# Origens fixas do painel e do auth (o destino depois do login é montado com elas; nunca vem da URL).
# Em dev têm padrão (3001 e 3002). Em build de produção são obrigatórias, sem padrão:
# ex. https://ufba.app e https://auth.ufba.app.
VITE_PANEL_ORIGIN=http://localhost:3001
VITE_AUTH_ORIGIN=http://localhost:3002
