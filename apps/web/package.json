{
  "name": "@ufba-app/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dev:auth": "vite -c vite.auth.config.ts",
    "build:auth": "tsc --noEmit && vite build -c vite.auth.config.ts",
    "preview:auth": "vite preview -c vite.auth.config.ts",
    "size": "node scripts/check-bundle-size.mjs",
    "size:auth": "node scripts/check-bundle-size-auth.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:auth": "playwright test -c playwright.auth.config.ts",
    "e2e:auth:real": "playwright test -c playwright.auth.real.config.ts",
    "e2e:auth:prod": "playwright test -c playwright.auth.prod.config.ts",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@hookform/resolvers": "^7.0.5",
    "@tanstack/react-query": "^5.107.1",
    "@ufba-app/tokens": "workspace:*",
    "@ufba-app/web-ui": "workspace:*",
    "cpf-cnpj-validator": "^2.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router": "^8.5.1",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "msw": "^3.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "vitest-axe": "^0.1.0"
  }
}
