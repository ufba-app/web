# syntax=docker/dockerfile:1
#
# Imagem do app de autenticação (auth.ufba.app): compila com Node e serve os arquivos estáticos com Caddy.
# O contexto do build é a RAIZ do monorepo (precisa de packages/web-ui e packages/tokens):
#   docker build -f apps/web/Dockerfile.auth --build-arg VITE_PANEL_ORIGIN=https://ufba.app \
#     --build-arg VITE_AUTH_ORIGIN=https://auth.ufba.app .
# Sem token e sem registry privado: o design system vem do próprio workspace.
# NÃO FOI TESTADA: não havia Docker na máquina de desenvolvimento.

FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/
COPY packages/tokens/package.json packages/tokens/
COPY packages/web-ui/package.json packages/web-ui/
RUN pnpm install --frozen-lockfile

COPY . .
# Endereços públicos. Ficam dentro do JS gerado (não são segredo), por isso são variáveis de build.
# As origens do painel e do auth NÃO têm padrão: o destino pós-login e o redirect_uri são montados com elas, e um
# padrão silencioso apontaria para o lugar errado. Sem elas o build falha (vite.auth.config.ts).
ARG VITE_API_URL=https://api.ufba.app
ARG VITE_PANEL_ORIGIN
ARG VITE_AUTH_ORIGIN
ENV VITE_API_URL=${VITE_API_URL} \
    VITE_PANEL_ORIGIN=${VITE_PANEL_ORIGIN} \
    VITE_AUTH_ORIGIN=${VITE_AUTH_ORIGIN}
RUN pnpm build:auth

FROM caddy:2-alpine
COPY apps/web/Caddyfile.auth /etc/caddy/Caddyfile
COPY --from=build /app/apps/web/dist-auth /srv
# O Railway define PORT; o Caddyfile escuta nela (padrão 8080).
EXPOSE 8080
