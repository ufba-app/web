---
// Marca do cabeçalho: brasão + "ufba.app" + pílula "docs" (canvas, tela 8 · Docs).
---

<a class="ufba-logo" href="/">
  <img src="/brasao.svg" alt="" width="36" height="36" />
  <span>ufba.app</span>
  <em>docs</em>
</a>

<style>
  .ufba-logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--sl-color-text-accent);
    font: 800 18px/1 var(--ufba-font-display);
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .ufba-logo img {
    width: 36px;
    height: 36px;
  }
  .ufba-logo em {
    font: 800 12px/1 var(--ufba-font-body);
    font-style: normal;
    padding: 6px 10px;
    border-radius: 99px;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-gray-3);
  }
</style>
