{
  "name": "@ufba-app/web-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Componentes React do ufba.app sobre HeroUI v3.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./switch": {
      "types": "./dist/switch.d.ts",
      "import": "./dist/switch.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-styles.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@ufba-app/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20",
    "tailwindcss": "^4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ufba-app/web.git",
    "directory": "packages/web-ui"
  }
}
