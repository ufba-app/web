{
  "name": "@ufba-app/tokens",
  "version": "0.0.0",
  "private": true,
  "description": "Tokens de design do ufba.app: cor, tipografia, raio e espaçamento.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && tsx scripts/build.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ufba-app/web.git",
    "directory": "packages/tokens"
  }
}
