# syntax=docker/dockerfile:1
#
# Imagem do app de autenticação (auth.ufba.app): compila com Node e serve os arquivos estáticos com Caddy.
# Uso: docker build -f Dockerfile.auth --build-arg VITE_PANEL_ORIGIN=https://ufba.app \
#        --build-arg VITE_AUTH_ORIGIN=https://auth.ufba.app .
# ANTES DE SUBIR: o package.json usa `link:../design-system/...` (link local) e isso não existe dentro do build.
# Troque por versões publicadas de @ufba-app/web-ui e @ufba-app/tokens (workflow Release do design-system) e atualize o pnpm-lock.yaml.
# NÃO FOI TESTADA: não havia Docker na máquina de desenvolvimento.

FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable

COPY package.json pnpm-lock.yaml .npmrc ./

# Token de leitura (read:packages) para instalar @ufba-app/* do GitHub Packages. Só existe neste estágio:
# a imagem final não herda nada dele. Nunca escreva o valor aqui; passe como variável de build do serviço.
ARG GITHUB_TOKEN
RUN echo "//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}" > /root/.npmrc \
    && pnpm install --frozen-lockfile \
    && rm -f /root/.npmrc

COPY . .
# Endereços públicos. Ficam dentro do JS gerado (não são segredo), por isso são variáveis de build.
# As origens do painel e do auth NÃO têm padrão: o destino pós-login e o redirect_uri são montados com elas, e um
# padrão silencioso apontaria para o lugar errado. Sem elas o build falha (vite.auth.config.ts).
ARG VITE_API_URL=https://api.ufba.app
ARG VITE_PANEL_ORIGIN
ARG VITE_AUTH_ORIGIN
ENV VITE_API_URL=${VITE_API_URL} \
    VITE_PANEL_ORIGIN=${VITE_PANEL_ORIGIN} \
    VITE_AUTH_ORIGIN=${VITE_AUTH_ORIGIN}
RUN pnpm build:auth

FROM caddy:2-alpine
COPY Caddyfile.auth /etc/caddy/Caddyfile
COPY --from=build /app/dist-auth /srv
# O Railway define PORT; o Caddyfile escuta nela (padrão 8080).
EXPOSE 8080
